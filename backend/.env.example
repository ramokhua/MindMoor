# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=False

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Model Configuration
BASE_MODEL=facebook/blenderbot-400M-distill
FINE_TUNED_DIR=./models/moira-finetuned
MODEL_TEMPERATURE=0.75
MAX_NEW_TOKENS=200

# Rate Limiting
RATE_LIMIT=30
RATE_WINDOW=60

# Port (for local dev; Render/Railway override this)
PORT=5000